{
  "name": "@kne/fastify-intl-admin",
  "version": "0.1.0",
  "description": "Fastify 业务插件：国际化语言类型与语言库管理（lang-type / lang-lib）",
  "main": "index.js",
  "scripts": {
    "init": "husky",
    "build:md": "npx @kne/md-doc",
    "start:md": "npx @kne/md-doc --watch",
    "prettier": "prettier --config .prettierrc --write '{libs/**/*,index}.{js,jsx,ts,tsx,json,css,scss}'",
    "lint-staged": "npx lint-staged",
    "test": "mocha test/**/*.test.js",
    "test:coverage": "nyc --reporter=html --reporter=text mocha test/**/*.test.js"
  },
  "lint-staged": {
    "{libs/**/*,index}.{js,jsx,ts,tsx,json,css,scss}": [
      "prettier --config .prettierrc --write",
      "git add"
    ]
  },
  "files": [
    "index.js",
    "libs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kne-union/fastify-intl-admin.git"
  },
  "keywords": [
    "fastify",
    "i18n",
    "intl",
    "lang",
    "translation",
    "admin"
  ],
  "author": "linzp",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kne-union/fastify-intl-admin/issues"
  },
  "homepage": "https://github.com/kne-union/fastify-intl-admin#readme",
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "peerDependencies": {
    "@kne/fastify-namespace": "*",
    "@kne/fastify-sequelize": "*",
    "fastify-plugin": ">=5"
  },
  "devDependencies": {
    "@fastify/env": "^5.0.2",
    "@kne/fastify-namespace": "*",
    "@kne/fastify-sequelize": "^3.0.6",
    "chai": "^6.2.2",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "husky": "^9.0.11",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.3",
    "nyc": "^17.1.0",
    "prettier": "^3.2.5",
    "sinon": "^21.0.0",
    "sqlite3": "^5.1.7"
  }
}
